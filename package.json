{
  "name": "linkedin-post-scraper",
  "version": "1.0.0",
  "description": "Public LinkedIn Post Scraper monorepo application",
  "main": "dist/server.js",
  "scripts": {
    "install:frontend": "npm install --prefix frontend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "tsc",
    "build": "npm run install:frontend && npm run build:frontend && npm run build:backend",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "dev:backend": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:frontend": "npm run --prefix frontend dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "playwright": "^1.45.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}